{
  "compilerOptions": {
    "target": "es2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "esnext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "removeComments": true
  },
  "references": [
    {
      "path": "./packages/bible-excerpt/tsconfig.json"
    },
    {
      "path": "./packages/bible-reading/tsconfig.json"
    },
    {
      "path": "./packages/day-selector/tsconfig.json"
    }
  ]
}